PORT=3000

# Supabase (publishable key pública — nunca service_role)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Motor de navegador Sekai
HOSHI_URL=https://backendv3-188.onrender.com
BROWSER_ENGINE=hoshi

# APIs de IA (opcionales; al menos una para /api/chat)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# Sekai Search Engine
SEARCH_INDEX_PATH=./data/search-index.json
SEARCH_SEEDS=https://www.wikipedia.org/,https://www.mozilla.org/,https://www.gnu.org/,https://developer.mozilla.org/,https://github.com/
SEARCH_CRAWL_MAX_PAGES=200
SEARCH_CRAWL_ON_START=false
SEARCH_CRAWL_INTERVAL_MINUTES=0
SEARCH_ADMIN_TOKEN=change-this-token
SEARCH_USER_AGENT=SekaiBot/1.0 (+search crawler)

# Sekai Private DNS (DoH upstream)
DOH_UPSTREAM=https://cloudflare-dns.com/dns-query
